/* Tsunagu-Pad: izinkan pengguna desktop yang sedang aktif di laptop ini (anggota
 * grup sudo) mengendalikan komponen Tsunagu-Pad tanpa mengetik kata sandi:
 *   - menyalakan/mematikan hotspot Tsunagu-Pad,
 *   - menyimpan nama & kata sandi hotspot.
 * Tidak memberi izin atas unit systemd atau program lain.
 * Polkit memakai JavaScript ES5: jangan pakai let/const/arrow function. */
polkit.addRule(function (action, subject) {
    if (!subject.local || !subject.active || !subject.isInGroup("sudo"))
        return polkit.Result.NOT_HANDLED;

    if (action.id === "org.freedesktop.systemd1.manage-units") {
        var unit = action.lookup("unit");
        var verb = action.lookup("verb");
        if (unit === "tsunagupad-hotspot.service" &&
            (verb === "start" || verb === "stop" || verb === "restart"))
            return polkit.Result.YES;
    }

    if (action.id === "org.freedesktop.policykit.exec" &&
        action.lookup("program") === "/usr/local/lib/tsunagupad/hotspot-config")
        return polkit.Result.YES;

    return polkit.Result.NOT_HANDLED;
});
